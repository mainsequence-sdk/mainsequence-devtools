{
  "name": "@dev-mainsequence/devtools",
  "version": "0.3.13",
  "description": "Shared MainSequence developer actions, project operations, MCP client and command runner",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ms-devtools": "./dist/runner.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.cjs",
    "release:check": "npm run typecheck && npm test && node scripts/check-release.cjs && npm pack --ignore-scripts --pack-destination artifacts && npm run verify:package"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mainsequence-sdk/mainsequence-devtools.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
